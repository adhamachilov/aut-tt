# Copy to .env.local. All of these stay on the server; none are sent to the browser.

# Supabase project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Telegram bot from @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random 16–256 chars [A-Za-z0-9_-]. Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Public https URL where this app runs (the Mini App opens here)
APP_URL=

# Organizers: comma-separated Telegram user IDs. They see the Admin tab in the app.
# Find yours by messaging @userinfobot in Telegram.
ADMIN_TELEGRAM_IDS=

LEAGUE_NAME=Table Tennis League

# Optional: comma-separated list to make "major" a dropdown instead of free text.
# MAJORS=Computer Science,Business,Economics,Law

# Development only (ignored in production): open http://localhost:3000 in a normal
# browser as this Telegram user, without Telegram.
# ALLOW_DEV_TELEGRAM_LOGIN=true
# DEV_TELEGRAM_USER_ID=123456789
